# Copy to deploy/.env and fill in. Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+='

# Public host names. Without a domain, sslip.io maps <ip-with-dashes>.sslip.io to the server's address,
# and Caddy gets Let's Encrypt certificates for it.
CAREERS_HOST=149-36-1-90.sslip.io
CONSOLE_HOST=console.149-36-1-90.sslip.io

POSTGRES_PASSWORD=
JWT_SECRET=

# true for the public demo: staff accounts can browse but not change or delete anything.
# Candidates can still check CVs, apply and erase their own data.
DEMO_READ_ONLY=true
RETENTION_DAYS=365
CLEARHIRE_VERSION=latest

# The Telegram bot (optional). Create one with @BotFather, then:
# COMPOSE_PROFILES=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=       # without @, for the "Apply in Telegram" link on the careers site
# BOT_SECRET=                  # shared by the API and the bot; 32+ characters
# RECRUITER_CHAT_IDS=          # chats told about new applications; send /whoami to the bot to get one

# Anchoring the audit log on a chain (contracts/AuditAnchor.sol). The default is the local Anvil service.
# 1. ANCHOR_PRIVATE_KEY: the publisher's key. For local Anvil, its first development account works
#    (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80, publicly known: never use it
#    on a real network). For a testnet, a fresh key funded from a faucet.
# 2. docker compose ... run --rm --no-deps anchor clearhire deploy-anchor   -> prints the contract address
# 3. ANCHOR_CONTRACT=<that address>, COMPOSE_PROFILES=anchoring (add telegram with a comma if used)
# ANCHOR_PRIVATE_KEY=
# ANCHOR_CONTRACT=
# ANCHOR_PERIOD_SECONDS=3600
# CHAIN_RPC_URL=https://sepolia.base.org
# CHAIN_NAME=Base Sepolia
# CHAIN_EXPLORER_TX_URL=https://sepolia.basescan.org/tx/
